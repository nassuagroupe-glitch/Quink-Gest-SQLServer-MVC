<Application x:Class="QuinkGest.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/LoginWindow.xaml">
    <Application.Resources>
        <!-- Affiche le texte de Tag comme indicatif (placeholder) tant que le champ est vide.
             Géré en code-behind (et non via un Trigger+Binding dans VisualBrush.Visual, qui ne
             se résout pas car ce TextBlock n'appartient pas à l'arbre visuel du TextBox). -->
        <Style TargetType="TextBox">
            <EventSetter Event="Loaded" Handler="TextBox_ActualiserIndicatif"/>
            <EventSetter Event="TextChanged" Handler="TextBox_ActualiserIndicatif"/>
        </Style>

        <!-- PasswordBox.Password n'étant pas bindable, l'indicatif est géré en code-behind (App.xaml.cs). -->
        <Style TargetType="PasswordBox">
            <EventSetter Event="Loaded" Handler="PasswordBox_ActualiserIndicatif"/>
            <EventSetter Event="PasswordChanged" Handler="PasswordBox_ActualiserIndicatif"/>
        </Style>
    </Application.Resources>
</Application>
