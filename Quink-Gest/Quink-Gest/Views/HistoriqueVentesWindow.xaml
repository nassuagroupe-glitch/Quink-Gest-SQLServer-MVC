<Window x:Class="QuinkGest.Views.HistoriqueVentesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historique des ventes du jour" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TexteTotal" Grid.Row="0" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <DataGrid x:Name="GrilleVentes" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Numéro" Binding="{Binding Numero}" Width="160"/>
                <DataGridTextColumn Header="Client" Binding="{Binding ClientNom}" Width="140"/>
                <DataGridTextColumn Header="Montant" Binding="{Binding MontantTotal}" Width="100"/>
                <DataGridTextColumn Header="Mode" Binding="{Binding ModePaiement}" Width="120"/>
                <DataGridTextColumn Header="Heure" Binding="{Binding DateVente, StringFormat=HH:mm}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
