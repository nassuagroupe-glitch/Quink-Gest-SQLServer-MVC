<Window x:Class="QuinkGest.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuinkGest — Tableau de bord" Height="760" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F0F0F5"/>
            <Setter Property="BorderBrush" Value="#D0D0D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E2E2EC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D5D5E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StyleBoutonEtablissement" TargetType="Button">
            <Setter Property="Background" Value="#F0F0F5"/>
            <Setter Property="BorderBrush" Value="#D0D0D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E2E2EC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D5D5E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Le fond d'écran couvre exactement la page (même hauteur/largeur que la fenêtre) -->
        <Image Source="/Assets/LoginBackground.png" Stretch="UniformToFill"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <Border Background="#F0FFFFFF" CornerRadius="12" Margin="24" Padding="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TexteBienvenue" Grid.Row="0" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock x:Name="TexteVenteJour" Grid.Row="1" FontSize="16" Margin="0,0,0,24"/>

                <UniformGrid Grid.Row="2" Columns="3" Rows="4">
                    <Button Margin="9" Padding="18" Click="BoutonVente_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeVente.png" Width="64" Height="64" Margin="0,0,14,0"/>
                            <TextBlock Text="Nouvelle vente" FontSize="17" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="9" Padding="18" Click="BoutonProduits_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeProduits.png" Width="64" Height="64" Margin="0,0,14,0"/>
                            <TextBlock Text="Produits &amp; Stock" FontSize="17" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="9" Padding="18" Click="BoutonFournisseurs_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeFournisseurs.png" Width="64" Height="64" Margin="0,0,14,0"/>
                            <TextBlock Text="Fournisseurs" FontSize="17" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="9" Padding="18" Click="BoutonClients_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeClients.png" Width="64" Height="64" Margin="0,0,14,0"/>
                            <TextBlock Text="Clients" FontSize="17" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="9" Padding="18" Click="BoutonHistorique_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeHistorique.png" Width="64" Height="64" Margin="0,0,14,0"/>
                            <TextBlock Text="Historique des ventes" FontSize="17" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="9" Padding="18" Click="BoutonDepenses_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeDepenses.png" Width="64" Height="64" Margin="0,0,14,0"/>
                            <TextBlock Text="Dépenses" FontSize="17" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="9" Padding="18" Click="BoutonRapportCaisse_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeRapportCaisse.png" Width="64" Height="64" Margin="0,0,14,0"/>
                            <TextBlock Text="Rapport de caisse" FontSize="17" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="9" Padding="18" Click="BoutonCredit_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeCredit.png" Width="64" Height="64" Margin="0,0,14,0"/>
                            <TextBlock Text="Crédit en cours" FontSize="17" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="9" Padding="18" Click="BoutonRelances_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeRelances.png" Width="64" Height="64" Margin="0,0,14,0"/>
                            <TextBlock Text="Relances" FontSize="17" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="9" Padding="18" Click="BoutonAlertes_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeAlertes.png" Width="64" Height="64" Margin="0,0,14,0"/>
                            <TextBlock Text="Alertes de stock" FontSize="17" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="9" Padding="18" Click="BoutonParametres_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeParametres.png" Width="64" Height="64" Margin="0,0,14,0"/>
                            <TextBlock Text="Paramètres" FontSize="17" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="9" Padding="18" Click="BoutonDeconnexion_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeDeconnexion.png" Width="64" Height="64" Margin="0,0,14,0"/>
                            <TextBlock Text="Se déconnecter" FontSize="17" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>
        </Border>

        <Button x:Name="BoutonEtablissement" Style="{StaticResource StyleBoutonEtablissement}"
                Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,36,36,0" ToolTip="Établissement" Click="BoutonEtablissement_Click">
            <Viewbox Width="22" Height="22">
                <Canvas Width="24" Height="24">
                    <Path Fill="Black" Data="M10,20 V14 H14 V20 H19 V12 H22 L12,3 L2,12 H5 V20 H10 Z"/>
                </Canvas>
            </Viewbox>
        </Button>
    </Grid>
</Window>
