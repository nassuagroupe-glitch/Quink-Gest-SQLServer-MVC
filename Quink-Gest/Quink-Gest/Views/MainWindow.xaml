<Window x:Class="QuinkGest.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuinkGest — Tableau de bord" Height="640" Width="920"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F0F0F5"/>
            <Setter Property="BorderBrush" Value="#D0D0D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E2E2EC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D5D5E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Le fond d'écran couvre exactement la page (même hauteur/largeur que la fenêtre) -->
        <Image Source="/Assets/LoginBackground.png" Stretch="UniformToFill"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <Border Background="#F0FFFFFF" CornerRadius="12" Margin="24" Padding="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TexteBienvenue" Grid.Row="0" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock x:Name="TexteVenteJour" Grid.Row="1" FontSize="14" Margin="0,0,0,24"/>

                <UniformGrid Grid.Row="2" Columns="3" Rows="3">
                    <Button Margin="8" Padding="16" Click="BoutonVente_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeVente.png" Width="48" Height="48" Margin="0,0,10,0"/>
                            <TextBlock Text="Nouvelle vente" FontSize="14" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="8" Padding="16" Click="BoutonProduits_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeProduits.png" Width="48" Height="48" Margin="0,0,10,0"/>
                            <TextBlock Text="Produits &amp; Stock" FontSize="14" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="8" Padding="16" Click="BoutonFournisseurs_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeFournisseurs.png" Width="48" Height="48" Margin="0,0,10,0"/>
                            <TextBlock Text="Fournisseurs" FontSize="14" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="8" Padding="16" Click="BoutonClients_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeClients.png" Width="48" Height="48" Margin="0,0,10,0"/>
                            <TextBlock Text="Clients" FontSize="14" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="8" Padding="16" Click="BoutonHistorique_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeHistorique.png" Width="48" Height="48" Margin="0,0,10,0"/>
                            <TextBlock Text="Historique des ventes" FontSize="14" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="8" Padding="16" Click="BoutonDepenses_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeDepenses.png" Width="48" Height="48" Margin="0,0,10,0"/>
                            <TextBlock Text="Dépenses" FontSize="14" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="8" Padding="16" Click="BoutonAlertes_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeAlertes.png" Width="48" Height="48" Margin="0,0,10,0"/>
                            <TextBlock Text="Alertes de stock" FontSize="14" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="8" Padding="16" Click="BoutonParametres_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeParametres.png" Width="48" Height="48" Margin="0,0,10,0"/>
                            <TextBlock Text="Paramètres" FontSize="14" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="8" Padding="16" Click="BoutonDeconnexion_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/IconeDeconnexion.png" Width="48" Height="48" Margin="0,0,10,0"/>
                            <TextBlock Text="Se déconnecter" FontSize="14" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
