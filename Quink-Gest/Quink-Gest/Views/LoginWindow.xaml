<Window x:Class="QuinkGest.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuinkGest — Connexion" Height="720" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#2B2B31">
        <Border Background="#F0FFFFFF" CornerRadius="12" Width="360" Height="420"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel Margin="28" VerticalAlignment="Center">
                <TextBlock Text="QuinkGest" FontSize="24" FontWeight="Bold" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                <TextBlock Text="Gestion de quincaillerie" FontSize="12" Foreground="Gray"
                           Margin="0,0,0,24" HorizontalAlignment="Center"/>

                <TextBlock Text="Nom d'utilisateur"/>
                <TextBox x:Name="ChampNomUtilisateur" Margin="0,4,0,12" Padding="6" Tag="Nom d'utilisateur"/>

                <TextBlock Text="Mot de passe"/>
                <PasswordBox x:Name="ChampMotDePasse" Margin="0,4,0,12" Padding="6" Tag="Mot de passe"/>

                <CheckBox x:Name="CaseSouvenirMotDePasse" Content="Se souvenir du mot de passe" Margin="0,0,0,16"/>

                <Button x:Name="BoutonConnexion" Content="Se connecter" Padding="8" Click="BoutonConnexion_Click"/>

                <TextBlock x:Name="TexteMessage" Foreground="Red" Margin="0,12,0,0"
                           TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
